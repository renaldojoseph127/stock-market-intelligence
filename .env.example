NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_. Required for import preview/confirmation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Number of PDFs claimed per short preview-processing request (1-10).
IMPORT_PREVIEW_BATCH_SIZE=2
# Optional server-only directory for rendered page, crop, pass, and segment PNG diagnostics.
# IMPORT_OCR_DEBUG_DIR=/absolute/path/outside-public-web-root

# Reddit collection is disabled by default. Supported values: disabled, devvit_bridge,
# or legacy_oauth. Devvit is the current production architecture.
REDDIT_PROVIDER_MODE=disabled
# Current read-only Devvit bridge. All values are server-only; never prefix with NEXT_PUBLIC_.
# External Endpoints is limited access. Keep false until Reddit has approved this exact
# research, external-storage, retention/deletion, and managed-endpoint architecture.
DEVVIT_REDDIT_ACCESS_APPROVED=false
DEVVIT_REDDIT_BRIDGE_URL=https://your-app-your-location-external.devvit.net/external/research
DEVVIT_REDDIT_MANAGED_TOKEN=devvit_at_your-managed-token
# Optional legacy OAuth compatibility only. These are not required in devvit_bridge mode.
# REDDIT_CLIENT_ID=your-authorized-legacy-client-id
# REDDIT_CLIENT_SECRET=your-authorized-legacy-client-secret
# REDDIT_USER_AGENT=web:stock-market-intelligence:v1.0.0 (by /u/your_username)
# REDDIT_DATA_API_AUTHORIZED=false
# Conservative application limits; all are server-only and hard-clamped.
REDDIT_REQUESTS_PER_MINUTE=60
REDDIT_MAX_RETRIES=3
REDDIT_CACHE_TTL_HOURS=6
REDDIT_SYNC_TIMEOUT_MS=20000
SOCIAL_RESEARCH_DAILY_REQUEST_BUDGET=100
SOCIAL_RESEARCH_BATCH_SIZE=1
SOCIAL_RESEARCH_MAX_QUERY_PAGES=3
SOCIAL_RESEARCH_RETENTION_HOURS=48

# Phase 2A reference providers. SEC requires a descriptive application/contact user agent.
SEC_USER_AGENT=stock-market-intelligence/1.0 contact@example.com
# Phase 2B SEC EDGAR catalyst research. All values are server-only.
# Conservative default; application configuration is clamped to at most 9.
SEC_REQUESTS_PER_SECOND=5
SEC_CACHE_TTL_HOURS=24
SEC_MAX_RETRIES=3
CATALYST_QUEUE_BATCH_SIZE=1
CATALYST_QUEUE_MAX_ATTEMPTS=3
CATALYST_DEFAULT_DAYS_BEFORE=7
CATALYST_DEFAULT_DAYS_AFTER=2
# Filing bodies are fetched only selectively. These bounds protect memory/storage.
CATALYST_MAX_FILING_DOWNLOAD_BYTES=5242880
CATALYST_MAX_EXTRACTED_TEXT_CHARACTERS=100000
CATALYST_MAX_STORED_EVIDENCE_CHARACTERS=4000
# Optional market-data supplement. Keep this server-only.
FINNHUB_API_KEY=your-finnhub-api-key

# Phase 2A.1 on-demand metadata. All values are server-only.
# Alpha Vantage Company Overview is the default first provider when configured.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
# Shared hard application budget across the provider rotation.
METADATA_DAILY_BUDGET=20
METADATA_SYNC_TIMEOUT_MS=3500
METADATA_STALE_DAYS=180
METADATA_MAX_RETRIES=3
METADATA_NOT_FOUND_COOLDOWN_DAYS=30
# Worker claims are clamped to 1-10.
METADATA_QUEUE_BATCH_SIZE=5
METADATA_PROVIDER_PRIORITY=alpha_vantage,sec_company_tickers,finnhub
